# SIH thermal-anomaly monitoring backend - all config is environment-driven.
# Copy to .env and fill in your secrets. Never commit the real .env.

POSTGRES_DB=thermal_anomaly
POSTGRES_USER=thermal_admin
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NASA FIRMS Map Key (request a free one at
# https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

# ---------------------------------------------------------------------------
# FIRMS ingestion (defaults shown)
# ---------------------------------------------------------------------------
# Sources queried by the scheduler / CLI. Supported:
#   VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
FIRMS_BBOX=68,6,98,38            # west,south,east,north
FIRMS_DAYS=2                     # NRT window in days (1..5)
# FIRMS_SOURCE / FIRMS_DAYS (singular) are also accepted for backward
# compatibility by the on-demand ingest CLI.

# ---------------------------------------------------------------------------
# Near-real-time worker
# ---------------------------------------------------------------------------
FIRMS_POLL_INTERVAL_MIN=10       # seconds between ingestion cycles
WORKER_OSM_CONTEXT=0             # 1 = also refresh OSM facility context for new
                                 #     hotspots (async, opt-in; Overpass stays
                                 #     OFF the live path by default)

# ---------------------------------------------------------------------------
# OSM / Overpass industrial ingestion (defaults shown)
# ---------------------------------------------------------------------------
# OSM_BBOX=68,6,98,38            # west,south,east,north (region to query)
# OSM_CHUNKS=1                   # tile the bbox into an N x N grid for smaller
#                                # requests (keeps public Overpass happy)
# OVERPASS_URL=                  # optional custom Overpass endpoint; otherwise
#                                # the public mirrors are tried in order

# Facility-context ingestion: small Overpass queries around each hotspot
# (defaults shown)
# OSM_CONTEXT_RADIUS_M=7000      # radius around each hotspot, in meters
# OSM_CONTEXT_MAX_RETRIES=2      # per-hotspot Overpass attempts
# OSM_CONTEXT_MAX_FAILURES=10    # consecutive failures before aborting
# OSM_CONTEXT_MIN_INTERVAL_S=2.0 # pause between hotspot queries
# OSM_HTTP_TIMEOUT=25            # per-request HTTP read timeout (s)

# ---------------------------------------------------------------------------
# Enrichment / persistence tuning (defaults shown)
# ---------------------------------------------------------------------------
PERSIST_RADIUS_M=1000            # meters for "same location" clustering
PERSIST_WINDOW_DAYS=7            # 7-d recurrence window
PERSIST_DENOM=5                  # detections that yield persistence 1.0

# ---------------------------------------------------------------------------
# Future vision-model integration (optional; stored as enrichment fields).
# The backend never requires these; classification works without them.
# ---------------------------------------------------------------------------
# VISION_FIRE_THRESHOLD=0.7
# VISION_FLARE_THRESHOLD=0.6
# VISION_INDUSTRY_THRESHOLD=0.8
POSTGRES_DB=thermal_anomaly
POSTGRES_USER=thermal_admin
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NASA FIRMS Map Key (request a free one at
# https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

# Optional ingestion overrides (defaults shown)
# FIRMS_SOURCE=VIIRS_NOAA20_NRT
# FIRMS_BBOX=68,6,98,38
# FIRMS_DAYS=2

# OSM / Overpass industrial ingestion (defaults shown)
# OSM_BBOX=68,6,98,38            # west,south,east,north (region to query)
# OSM_CHUNKS=1                   # tile the bbox into an N x N grid for smaller
#                                # requests (keeps public Overpass happy)
# OVERPASS_URL=                  # optional custom Overpass endpoint; otherwise
#                                # the public mirrors are tried in order
